---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout
  title="Services — AI Automation & Lead Generation Studio"
  description="What we do and how we do it. End-to-end AI automation, lead engines, creative pipelines, and custom software engineered for immediate pipeline impact."
  currentPath="/services"
>
  <div id="services-page" class="w-full bg-[#FAF9F6] text-[#1A1A1A]">
    <!-- PAGE HEADER -->
    <PageHeader
      id="services-header"
      eyebrow="Services"
      title="What we do / and how we do it."
      subtitle="End-to-end AI automation, lead engines, creative pipelines, and custom software — engineered for immediate pipeline impact."
    />

    <!-- DETAILED SERVICES BREAKDOWN -->
    <section
      id="services-breakdown-section"
      class="w-full py-14 sm:py-18 md:py-20 border-b border-black/10"
    >
      <div class="w-full max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-20 text-left">
        <div class="divide-y divide-black/10">
          <!-- 01 -->
          <div id="service-item-01" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">01</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                AI Automation & Internal Workflows
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                Eliminate manual bottlenecks across operations, client onboarding, and reporting.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                We design and deploy custom event-driven automation systems tailored strictly to your operations. No generic Zapier templates with fragile connections. We build resilient webhook engines with self-healing retries that sync data across your ERP, CRM, Slack, and accounting stacks automatically.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Multi-app workflow architecture & webhook pipeline</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Intelligent document ingestion and automated data extraction</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Automated customer onboarding & contract dispatch</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Real-time Slack/Teams anomaly & milestone alerting</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Eliminates 30–50 hours of repetitive data entry per week with 99.9% pipeline uptime.
                </p>
              </div>
            </div>
          </div>

          <!-- 02 -->
          <div id="service-item-02" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">02</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                AI Video Creation & Creative Systems
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                High-velocity short-form creative, programmatic UGC, and localized video at scale.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                Turn text prompts and customer testimonials into high-converting video assets ready for Meta, TikTok, and YouTube Shorts. We establish dynamic scripting, synthetic voice cloning, auto-captions, and automated B-roll insertion engines that allow you to test 30 variations in the time it usually takes to shoot one.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Automated video rendering pipelines with dynamic aspect ratios</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>AI voice model training & studio-grade synthesis</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Automated kinetic typography & subtitle synchronization</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Batch generation for paid social split-testing</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  10x increase in weekly creative testing volume at a fraction of traditional production costs.
                </p>
              </div>
            </div>
          </div>

          <!-- 03 -->
          <div id="service-item-03" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">03</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                Lead Generation Systems
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                End-to-end inbound and outbound infrastructure that routes vetted buyers to sales.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                Stop relying on unverified lists and broken forms. We build proprietary scraping and lead enrichment engines that monitor buying signals, identify company hiring spikes or tech stack changes, score prospects mathematically, and inject warm qualified leads straight into your sales pipeline.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Intent-based data scrapers & waterfall enrichment (Apollo, Clay, Clearbit)</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Algorithmic qualification scoring & deduplication logic</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Instant routing to calendar booking engines with qualification filters</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Two-way CRM sync (HubSpot, Salesforce, Pipedrive)</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Consistent influx of verified ICP contacts with complete company context on day one.
                </p>
              </div>
            </div>
          </div>

          <!-- 04 -->
          <div id="service-item-04" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">04</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                Cold Email & Outreach Infrastructure
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                Deliverability-hardened outbound engines that generate qualified pipeline on autopilot.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                Outreach fails when domains burn and copy looks like spam. We set up isolated secondary domains, custom DNS records (SPF, DKIM, DMARC), progressive warm-up schedules, and hyper-relevant dynamic personalization algorithms that maintain 65%+ open rates and keep your primary domain safe.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Secondary domain procurement & DNS security hardening</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Inbox warm-up monitoring & deliverability rotation</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>AI-enriched copy personalization based on prospect website & news</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Automated inbox triage & booking notification webhooks</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Predictable qualified meeting volume without manual follow-up or reputation risk.
                </p>
              </div>
            </div>
          </div>

          <!-- 05 -->
          <div id="service-item-05" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">05</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                Website Design & High-Conversion Systems
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                Clean editorial web applications engineered for speed, authority, and conversion.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                We reject slow, bloated page builders and template themes. We build bespoke digital front doors using modern performant stacks that load instantly, articulate your value proposition with editorial clarity, and guide visitors toward high-intent booking conversions.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Custom typographic and layout systems tailored to your brand identity</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Sub-second load times with clean semantic markup</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Native calendar booking and interactive qualification funnels</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Continuous maintenance, uptime monitoring, and speed optimization</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Elevated brand credibility and a measurable lift in visitor-to-call conversion rates.
                </p>
              </div>
            </div>
          </div>

          <!-- 06 -->
          <div id="service-item-06" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">06</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                Content Strategy & Editorial Engines
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                Compounding organic authority systems rather than sporadic, disjointed posts.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                Transform one long-form conversation, podcast, or client case study into a multi-channel editorial engine. We build structured workflows that distill core insights into LinkedIn thought-leadership essays, newsletters, X threads, and search-indexed technical breakdowns systematically.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Source-to-channel repurposing workflows & prompt frameworks</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Editorial calendar synchronization with automated staging</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Brand tone guidelines embedded directly into generation models</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Analytics aggregation tracking engagement signals and attribution</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Sustained top-of-mind brand presence without draining internal founder or executive time.
                </p>
              </div>
            </div>
          </div>

          <!-- 07 -->
          <div id="service-item-07" class="py-8 sm:py-10 lg:py-12 grid grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-start">
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span class="font-body text-sm sm:text-base font-medium tabular-nums text-neutral-400 block pt-1">07</span>
            </div>
            <div class="col-span-12 sm:col-span-10 lg:col-span-5">
              <h3 class="font-headline font-medium text-2xl sm:text-3xl lg:text-[32px] leading-tight text-[#1A1A1A]">
                Software Development & Custom AI Solutions
              </h3>
              <p class="font-body text-base sm:text-lg text-neutral-500 mt-4 leading-relaxed">
                Tailored web apps, internal dashboards, and fine-tuned proprietary AI models.
              </p>
            </div>
            <div class="col-span-12 lg:col-span-6 space-y-6">
              <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed">
                When off-the-shelf software falls short, we build custom micro-SaaS applications, private internal portals, and bespoke AI applications. We handle everything from database architecture to secure API routing and frontend interaction design.
              </p>
              <div class="pt-2 border-t border-black/[0.06]">
                <span class="font-body text-xs uppercase tracking-wider text-neutral-400 block mb-3 font-medium">Core Architecture</span>
                <ul class="space-y-2 font-body text-sm sm:text-[15px] text-[#1A1A1A]">
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Custom full-stack web applications (TypeScript, Node, React, PostgreSQL)</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Proprietary API gateway integrations & authenticated client portals</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>Private Retrieval-Augmented Generation (RAG) on internal company docs</span></li>
                  <li class="flex items-start gap-3"><span class="text-neutral-400 text-xs mt-0.5 select-none">—</span><span>End-to-end cloud deployment, CI/CD, and server-side observability</span></li>
                </ul>
              </div>
              <div class="pt-3 border-t border-black/[0.06]">
                <p class="font-body text-xs sm:text-sm text-[#C84826] font-medium leading-relaxed">
                  Proprietary IP and custom tools that create defensible operational moats for your business.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW WE ENGAGE / ENGAGEMENT MODELS -->
    <section
      id="engagement-models-section"
      class="w-full py-14 sm:py-18 md:py-20 border-b border-black/10"
    >
      <div class="w-full max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-20 text-left">
        <p class="font-body text-[13px] uppercase tracking-[0.1em] text-neutral-500 mb-3 select-none">
          Engagement models
        </p>
        <h2
          id="engagement-models-heading"
          class="font-headline font-normal sm:font-medium text-3xl sm:text-4xl md:text-[44px] leading-tight tracking-[-0.02em] text-[#1A1A1A] mb-8 sm:mb-10"
        >
          How we partner with your team
        </h2>

        <div class="grid grid-cols-12 gap-8 md:gap-12 lg:gap-16">
          <div id="model-sprint" class="col-span-12 md:col-span-6 border-t border-black/10 pt-5 sm:pt-6">
            <span class="font-body text-xs sm:text-sm font-medium tabular-nums text-neutral-400 block mb-2">01</span>
            <h3 class="font-headline font-medium text-2xl sm:text-3xl text-[#1A1A1A] mb-3">
              Sprint Build (Fixed Scope)
            </h3>
            <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed mb-4">
              Best for businesses that need a specific system built, tested, and handed over fast. We map the requirements, engineer the pipeline, integrate your tools, train your team, and guarantee performance.
            </p>
            <div class="font-body text-sm text-neutral-500 space-y-1.5">
              <p>— 2 to 3 weeks delivery cycle</p>
              <p>— Direct builder access with daily updates</p>
              <p>— 30-day post-launch warranty & tuning</p>
            </div>
          </div>

          <div id="model-retainer" class="col-span-12 md:col-span-6 border-t border-black/10 pt-5 sm:pt-6">
            <span class="font-body text-xs sm:text-sm font-medium tabular-nums text-neutral-400 block mb-2">02</span>
            <h3 class="font-headline font-medium text-2xl sm:text-3xl text-[#1A1A1A] mb-3">
              Dedicated Systems Partner
            </h3>
            <p class="font-body text-base sm:text-[17px] text-neutral-600 leading-relaxed mb-4">
              For companies scaling rapidly that require continuous automation engineering, outbound optimization, video creative testing, and technical growth infrastructure as an embedded operational arm.
            </p>
            <div class="font-body text-sm text-neutral-500 space-y-1.5">
              <p>— Continuous iteration and new workflow builds</p>
              <p>— Ongoing deliverability & API monitoring</p>
              <p>— Dedicated Slack channel with same-day turnaround</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA SECTION -->
    <section
      id="final-cta-section"
      class="relative w-full bg-[#111110] text-[#FAF9F6] py-14 sm:py-18 md:py-20 lg:py-24 overflow-hidden"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.035] mix-blend-screen bg-repeat"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);"
      ></div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-20">
        <div class="max-w-4xl text-left">
          <h2
            id="final-cta-headline"
            class="font-headline font-normal sm:font-medium text-4xl sm:text-5xl md:text-6xl lg:text-[72px] leading-[1.06] tracking-[-0.03em] text-[#FAF9F6]"
          >
            Have a project in mind?
          </h2>
          <p
            id="final-cta-subheadline"
            class="font-body font-normal text-base sm:text-lg md:text-[20px] text-neutral-400 leading-relaxed max-w-2xl mt-4 sm:mt-5 mb-6 sm:mb-8"
          >
            Tell us what you're trying to build — we'll tell you exactly how AI fits in.
          </p>
          <div>
            <button
              type="button"
              id="final-cta-button"
              class="inline-flex items-center justify-center font-body font-medium text-[15px] sm:text-base text-white bg-[#C84826] hover:bg-[#B33E1D] px-7 sm:px-9 py-3.5 sm:py-4 rounded-full transition-colors duration-200 cursor-pointer select-none"
            >
              Book a strategy call
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
