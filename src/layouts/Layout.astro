---
import Navigation from '../components/Navigation.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "AI Automation & Lead Generation Studio",
  description = "We design and build AI automation, video content, and outreach systems that turn attention into pipeline.",
  currentPath = "/about",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-90KWLEK0H3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-90KWLEK0H3');
    </script>

    <!-- Geotag / Local SEO (Gurugram, Haryana) -->
    <meta name="geo.region" content="IN-HR" />
    <meta name="geo.placename" content="Gurugram" />
    <meta name="geo.position" content="28.4632;77.0601" />
    <meta name="ICBM" content="28.4632, 77.0601" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAF9F6] text-[#1A1A1A] antialiased">
    <Navigation currentPath={currentPath} />
    <main>
      <slot />
    </main>
  </body>
</html>
