# =================================================================
# GrowthTechSys Environment Variables
# =================================================================

# Production Server Port
PORT=80
NODE_ENV=production

# =================================================================
# Nodemailer / SMTP Configuration
# Used to dispatch contact form submissions to rahulkumardrop@gmail.com
# =================================================================

# Destination email for all inquiries (configured as requested)
CONTACT_RECEIVER_EMAIL=rahulkumardrop@gmail.com

# SMTP Host & Port (Gmail SMTP default: smtp.gmail.com on SSL 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Gmail account
SMTP_USER=your-email@gmail.com

# 16-character Gmail App Password (NOT your regular Gmail login password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=your-16-char-app-password
